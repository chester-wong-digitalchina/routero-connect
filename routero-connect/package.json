{
  "name": "routero-connect",
  "displayName": "Routero Connect",
  "description": "Connect VS Code and supported AI coding agents to Routero, enabling secure API key management, model selection, automated configuration, and connection diagnostics.",
  "version": "0.0.5",
  "engines": {
    "vscode": "^1.146.0",
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "routero.connect",
        "title": "Routero: Connect"
      },
      {
        "command": "routero.integrationStatus",
        "title": "Routero: Integration Status"
      },
      {
        "command": "routero.doctor",
        "title": "Routero: Doctor"
      },
      {
        "command": "routero.testModel",
        "title": "Routero: Test Model"
      },
      {
        "command": "routero.disconnect",
        "title": "Routero: Disconnect"
      },
      {
        "command": "routero.storeCredential",
        "title": "Routero: Store Key for Codex"
      },
      {
        "command": "routero.stageHelper",
        "title": "Routero: Stage Codex Credential Helper"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run check-types && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "npm run test:unit",
    "test:unit": "npm run compile-tests && node --test \"out/test/unit/*.test.js\"",
    "test:vscode": "npm run compile-tests && npm run compile && vscode-test",
    "cli": "node dist/cli.js",
    "demo:config": "npm run compile-tests && node out/test/manual/config-engine-demo.js",
    "package:internal": "node scripts/package-internal.cjs",
    "test:installed": "npm run compile-tests && node scripts/test-installed.cjs"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.146.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "npm-run-all": "4.1.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "packageManager": "npm@11.16.0",
  "bin": {
    "routero-connect": "./dist/cli.js"
  },
  "dependencies": {
    "toml-eslint-parser": "1.0.3"
  },
  "publisher": "routero-internal",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/chester-wong-digitalchina/routero-connect.git"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Setup changes client configuration and accesses credentials only in trusted local Windows workspaces."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  }
}
